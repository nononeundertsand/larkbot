# 大模型配置。复制本文件为 .env 并填写；不配置时机器人以 mock 回声模式运行。
# 支持两种协议，用 LLM_PROVIDER 切换。

# ============ 方式一：字节 ModelHub / Azure OpenAI 协议 ============
# LLM_PROVIDER=azure
# LLM_AZURE_ENDPOINT=https://aidp.bytedance.net/api/modelhub/online/v2/crawl
# LLM_AZURE_API_VERSION=2024-03-01-preview
# LLM_API_KEY=你的_ModelHub_AK
# LLM_MODEL=gemini-3.5-flash
# LLM_LOGID=                       # 可选，不填则每次自动生成 X-TT-LOGID

# ============ 方式二：标准 OpenAI 兼容接口 ============
# LLM_PROVIDER=openai              # 默认值，可省略
# LLM_BASE_URL=https://api.openai.com/v1      # 脚本自动拼 /chat/completions
# LLM_API_URL=                     # 或填完整地址（优先级高于 base）
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ============ 通用可选项 ============
# LLM_TEMPERATURE=0.7              # 采样温度；GPT-5 等只支持默认值的模型请设 off（不发该字段）
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
# LLM_FALLBACK_MODEL=                   # 可选，主模型持续 429/5xx 后切换
# LLM_SYSTEM_PROMPT=你是一个部署在飞书里的智能助理，回答简洁、准确、友好。

# ============ 飞书机器人 / 主人身份 ============
# OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxx  # 主人 open_id；推荐显式配置；不填时默认尝试从 lark-cli 当前 user 登录态自动发现
# OWNER_AUTO_DISCOVER=on                 # OWNER_OPEN_ID 为空时是否自动发现主人，on/off，默认 on
# OWNER_NAME=主人
# LARK_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx   # 机器人 app_id，可选；不填则启动时尽力发现
# BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxx    # 机器人 open_id，可选
# BOT_NAME=个人助理机器人                 # 群聊 @ 文本兜底匹配用，可选
# FEISHU_SKILL_ROOT=.local/skills/feishu-skill  # 本地技能包路径；该目录默认不上传 git

# ============ 多模型：能力档案 + 任务路由 + 运行时切换（可选）============
# 单模型时用上面的 LLM_MODEL 即可；要在多个模型间切换/路由才需要下面这些。
# 能力档案（JSON 数组）：每个模型声明自身能力，requestLLM 按档案裁剪请求体，避免「模型不支持某参数」的 400。
#   temperature: 数字=默认温度 | "off"/"fixed"=不发 temperature（GPT-5 系列必须这样）
#   tools: 是否支持 function calling（默认 true）  vision: 是否支持图片（默认 true）
#   maxTokensField: max_tokens | max_completion_tokens（GPT-5 系列用后者）| 留空=不发
#   maxTokens: 默认输出 token 上限；extraBody: 额外透传 body，如 Gemini thinking
# LLM_MODELS=[{"id":"gemini-3.1-p","temperature":"off","tools":true,"vision":true,"maxTokensField":"max_tokens","maxTokens":4096,"extraBody":{"thinking":{"include_thoughts":true,"budget_tokens":2000}}},{"id":"gpt-5.6-sol","temperature":"off","maxTokensField":"max_completion_tokens","vision":true},{"id":"gemini-3.5-flash","temperature":0.7,"vision":true}]
# 任务路由：把某类任务指到指定模型（值必须在 LLM_MODELS/LLM_MODEL 中；未配置回落默认模型）
# LLM_ROUTE_VISION=gemini-3.5-flash     # 图片识别
# LLM_ROUTE_FAST=gemini-3.5-flash       # 安全评估 / 意图分类 / 记忆抽取 / 查人组织答案等轻任务
# LLM_ROUTE_REASONING=gpt-5.6-sol       # 群聊主推理 / 收敛作答等重任务
# 运行时切换：主人在飞书里说「换成 xxx 模型」即可临时切换默认模型（进程重启回落本文件）。

# ============ Agent / lark-cli 可靠性 ============
# AGENT_MAX_ITERS=6
# AGENT_MAX_TOOL_CALLS=10
# LARK_TIMEOUT_MS=30000
# LARK_MAX_OUTPUT_BYTES=2000000
# EVENT_QUEUE_MAX=100
# CONFIRM_TTL_MS=300000
# SECURITY_REFUSAL_STYLE=teasing         # 访客高风险请求拒绝语气：teasing(默认，轻微挑衅) / firm(严肃)
# LOG_CONTENT=off                       # 默认不把用户正文写入日志

# ============ 受限 Shell（危险能力，默认关闭）============
# SHELL_ENABLED=off                      # 设 on 后主人可用 run_shell_command；访客始终不可见
# SHELL_SANDBOX_ROOT=                    # Shell 沙箱根目录，默认当前项目根目录；cwd 只能是其内相对路径
# SHELL_TIMEOUT_MS=10000                 # 单条命令超时，范围 1s~60s
# SHELL_MAX_OUTPUT_BYTES=50000           # stdout+stderr 输出上限，范围 1KB~200KB
# SHELL_CONFIRM_ALL=off                  # on=所有 Shell 命令都要求确认；本机 runner 下无论读写都会兜底确认
# SHELL_ALLOW_PROJECT_COMMANDS=off       # on=允许 npm test / npm run check / npm run test；本机 runner 仍需确认，Docker ro 不额外确认
# SHELL_PATH=                            # 可覆盖受限 PATH；默认只含常见系统路径，不继承完整进程 env
# SHELL_DOCKER_ENABLED=off               # on=所有 Shell 命令都通过 docker run 执行；推荐生产开启；Docker ro 模式不额外人工确认
# SHELL_DOCKER_IMAGE=larkbot-shell-sandbox:latest  # 先执行：docker build -f docker/shell-sandbox.Dockerfile -t larkbot-shell-sandbox:latest .
# SHELL_DOCKER_BIN=docker
# SHELL_DOCKER_WORKSPACE_MODE=ro         # ro=只读挂载项目目录（默认，推荐）；rw=允许容器改项目文件，会重新要求主人确认
# SHELL_DOCKER_CPUS=1
# SHELL_DOCKER_MEMORY=512m
# SHELL_DOCKER_PIDS_LIMIT=128
# SHELL_DOCKER_PULL=never                # never=不自动拉镜像，避免执行时联网/漂移；需提前 build/pull
# 注：普通 Docker Shell 默认无网络；apt/apt-get download <包名> 以及受限 curl/wget 公开 http/https URL 下载会临时使用 network=bridge，并且不挂载 workspace、只在容器 /tmp 中执行。
# 不允许 sudo、apt install/update/upgrade，也不允许 curl/wget 携带 header/post/认证等复杂联网参数。
# PYTHON_CODE_TIMEOUT_MS=10000           # 访客安全 Python 沙箱超时；走 Docker，不挂载项目目录
# PYTHON_CODE_MAX_CHARS=8000             # 单次 Python 代码最大字符数
# PYTHON_CODE_MAX_OUTPUT_BYTES=50000     # Python 沙箱输出上限

# ============ 三层记忆 ============
# MEMORY_SHORT_TURNS=30                  # 短期滑动窗口轮数
# MEMORY_EXTRACT_EVERY=5                # 每几轮抽取一次关键记忆
# MEMORY_TTL_MS=1800000                # 短期无活动过期时长（默认 30 分钟）
# MEMORY_PERSIST_SHORT=off             # on=短期原文也落盘、重启可恢复（受 TTL 约束）；默认 off 仅内存
# MEMORY_DATA_DIR=                     # 自定义记忆落盘目录（默认 data/memory）
# MEMORY_CONTEXT_BUDGET_CHARS=12000    # 构造 prompt 时给记忆/历史的字符预算（粗略 token 预算）
# MEMORY_RELEVANT_LIMIT=8              # 每轮最多注入多少条相关长期记忆
# MEMORY_ITEM_LIMIT=120                # 每个场景最多保留多少条结构化长期记忆
# MEMORY_TEMP_TTL_MS=259200000         # 临时记忆 TTL，默认 3 天
# MEMORY_TASK_TTL_MS=1209600000        # 任务/待办记忆 TTL，默认 14 天
# MEMORY_DECISION_TTL_MS=15552000000   # 决策/约定记忆 TTL，默认 180 天
# MEMORY_STALE_MS=10368000000          # 非耐久记忆长期未使用清理阈值，默认 120 天
# GROUP_CONTEXT_PREFETCH=smart         # 群聊 @ 时预取最近上文：smart(默认)/on/off
# GROUP_CONTEXT_LIMIT=15               # 群聊上下文预取条数，最大 50
# GROUP_CONTEXT_INCLUDE_IMAGES=on      # 群聊 @ 自动预取上文时是否识别图片，默认 on；设 off 可降低延迟/成本
# CURRENT_MESSAGE_IMAGE_LIMIT=3        # 当前 @ 消息或私聊消息里最多识别多少张图片

# 旧运行时仅供临时排障，默认不要开启：
# AGENT_ENGINE=legacy
# ALLOW_UNSAFE_LEGACY=1

# 机器人回复身份：bot（默认）| user
# LARK_IDENTITY=bot

# ============ 联网搜索（web_search 工具）============
# 搜索源：bing（默认，公网，无需 key）| ddg（公网备选）| internal（内网 API）
# SEARCH_PROVIDER=bing

# 仅当 SEARCH_PROVIDER=internal 时需要：对接内网搜索 API（代码不写死任何内网地址）。
# 拿到内网搜索接口文档后填这里即可启用，无需改代码。
# SEARCH_INTERNAL_URL=https://你的内网搜索/api/search?q={query}&size={n}   # {query}/{n} 会被替换；不含占位符时自动追加 ?q=
# SEARCH_INTERNAL_TOKEN=你的鉴权token                # 可选
# SEARCH_INTERNAL_TOKEN_HEADER=Authorization         # 可选，token 放哪个头，默认 Authorization
# SEARCH_INTERNAL_TOKEN_PREFIX='Bearer '             # 可选，token 前缀，默认 "Bearer "（留空则直接用 token）
# SEARCH_INTERNAL_RESULT_PATH=data.results           # 可选，结果数组在 JSON 里的路径（点号分隔），不填则自动探测
# SEARCH_INTERNAL_FIELD_TITLE=title                  # 可选，条目标题字段名，默认 title
# SEARCH_INTERNAL_FIELD_URL=url                      # 可选，条目链接字段名，默认 url
# SEARCH_INTERNAL_FIELD_SNIPPET=snippet              # 可选，条目摘要字段名，默认 snippet

# ============ 网络抓取（web_fetch）可选项 ============
# WEB_TIMEOUT_MS=12000
# WEB_MAX_BYTES=1500000
